# ─────────────────────────────────────────────────────────────────────────────
# AI assistants / agent tooling (local caches, not project content)
# ─────────────────────────────────────────────────────────────────────────────
# These are runtime caches of local AI assistants and dev workflows. They
# never belong in version control. If you intentionally version a project's
# own skills under .agents/, add a tracked-allowlist rule below.
.agents/
.claude/
.codex/
.codegraph/
.impeccable/
.numasec/
.qwen/
.reasonix/

# Hook / session state files sometimes dropped at the repo root
.hookify/
.aider.*
.opencode/

# ─────────────────────────────────────────────────────────────────────────────
# Project-local junk
# ─────────────────────────────────────────────────────────────────────────────
# CUDA / GPU vendor artifacts
cuda-keyring_*.deb
*.deb
*.rpm

# Local cache files
model.cache
*.cache

# Personal/host filesystem leaks (e.g. accidentally created `home/<user>/`)
home/

# Worktrees live outside tracked content
.worktrees/

# Coverage HTML report
htmlcov/

